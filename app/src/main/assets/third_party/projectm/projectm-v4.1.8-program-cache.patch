+/**
+ * @brief Fills @a program from a program cache, linked, and returns true; or returns false to have it
+ *        compiled, after preparing it to be stored if the cache wants to (a retrievable binary).
+ */
+typedef bool (*projectm_program_load_func)(const char* vertex_source, const char* fragment_source, uint32_t program,
+                                           void* user_data);
+
+/**
+ * @brief Hands a program just linked from its sources to a program cache.
+ */
+typedef void (*projectm_program_store_func)(const char* vertex_source, const char* fragment_source, uint32_t program,
+                                            void* user_data);
+
+/**
+ * @brief The translated text kept for @a key (the key's bytes, @a key_length long), or NULL. The text must
+ *        stay valid until the next call on the same thread.
+ */
+typedef const char* (*projectm_shader_text_lookup_func)(const char* key, size_t key_length, void* user_data);
+
+/**
+ * @brief Keeps the translated text @a text for @a key.
+ */
+typedef void (*projectm_shader_text_store_func)(const char* key, size_t key_length, const char* text, void* user_data);
+
+/**
+ * @brief Sets the caches for every shader program the calling thread compiles from now on.
+ *
+ * A preset's warp and composite shaders are translated from HLSL and compiled when it loads, in the
+ * frame of the switch. With these, a host keeps the linked programs (as program binaries, say) and the
+ * translated text across loads and runs, so a preset seen before loads without either step. The caches
+ * are per thread; pass NULL for any of them to leave that one out.
+ *
+ * @param load_program Asked before a program is compiled.
+ * @param store_program Handed every program linked from source.
+ * @param lookup_text Asked before a preset shader is translated.
+ * @param store_text Handed every preset shader translation that compiled.
+ * @param user_data Passed to every callback.
+ */
+PROJECTM_EXPORT void projectm_opengl_set_shader_caches(projectm_program_load_func load_program,
+                                                       projectm_program_store_func store_program,
+                                                       projectm_shader_text_lookup_func lookup_text,
+                                                       projectm_shader_text_store_func store_text, void* user_data);
+
 #ifdef __cplusplus
 } // extern "C"
 #endif
