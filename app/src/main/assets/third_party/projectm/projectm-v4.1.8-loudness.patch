+void Loudness::UpdateBandAverage(double secondsSinceLastFrame, uint32_t /*frame*/)
 {
+    // Silence: hold the averages where they are and read neutral. Without this a new engine reads about
+    // 20x on its first frame (current over a long average starting at zero), and music coming back after
+    // a pause spikes by as much as the pause decayed the long average (11x after 10 s).
+    if (m_current < SilenceFloor)
+    {
+        m_currentRelative = 1.0f;
+        m_averageRelative = 1.0f;
+        return;
+    }
+
+    // The first real value starts both averages, so the relative values start at 1.0.
+    if (!m_primed)
+    {
+        m_average = m_current;
+        m_longAverage = m_current;
+        m_primed = true;
+    }
+
     float rate = AdjustRateToFps(m_current > m_average ? 0.2f : 0.5f, secondsSinceLastFrame);
     m_average = m_average * rate + m_current * (1.0f - rate);
 
