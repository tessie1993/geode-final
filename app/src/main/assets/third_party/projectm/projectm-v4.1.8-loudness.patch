+    rate = AdjustRateToFps(m_audibleSeconds < WarmUpSeconds ? 0.9f : 0.992f, secondsSinceLastFrame);
     m_longAverage = m_longAverage * rate + m_current * (1.0f - rate);
+    m_audibleSeconds += std::max(secondsSinceLastFrame, 0.0);
 
-    m_currentRelative = std::fabs(m_longAverage) < 0.001f ? 1.0f : m_current / m_longAverage;
-    m_averageRelative = std::fabs(m_longAverage) < 0.001f ? 1.0f : m_average / m_longAverage;
+    m_currentRelative = std::fabs(m_longAverage) < 0.001f ? 1.0f : Respond(m_current / m_longAverage);
+    m_averageRelative = std::fabs(m_longAverage) < 0.001f ? 1.0f : Respond(m_average / m_longAverage);
+}
+
+auto Loudness::Respond(float relative) const -> float
+{
+    return std::max(0.0f, 1.0f + m_response * (relative - 1.0f));
