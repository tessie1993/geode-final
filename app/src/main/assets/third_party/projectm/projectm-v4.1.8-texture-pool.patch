+auto TextureManager::RandomTexturePool() const -> std::vector<const ScannedFile*>
+{
+    std::vector<const ScannedFile*> pool;
+    std::set<std::string> names;
+    std::set<std::string> files;
+    for (const auto& file : m_scannedTextureFiles)
+    {
+        if (!names.insert(file.lowerCaseBaseName).second || !files.insert(RealFile(file.filePath)).second)
+        {
+            continue;
+        }
+        pool.push_back(&file);
+    }
+    return pool;
+}
