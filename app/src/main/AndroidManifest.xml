<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="true" />

    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- "Live input": the visuals react to the room instead of to a track.
         Requested at the moment the user turns that setting on, never at
         launch; samples go straight into the analysis ring buffer and are
         never written to disk or sent anywhere. The feature is optional, so
         the microphone is not a required device feature. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />
    <!-- Playback and video rendering need to keep running with no screen in
         front of them, and Android grants that to foreground services only.
         Being visible as a notification for as long as they last is the deal a
         foreground service is, so POST_NOTIFICATIONS belongs to both. Refused,
         the media notification simply does not appear; playback and its
         lock-screen controls are unaffected, since those come from the
         MediaSession rather than from the notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Music keeps playing when Geode is not on screen. Everything the
         platform then shows for it — the notification transport, the lock
         screen, a Bluetooth headset's buttons — is driven by the MediaSession
         in .playback.GeodePlaybackService (Playback's session), and none of it involves the network:
         titles come from the file's own tags and the local library. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!--
      A 4K render is tens of minutes of GPU work. Android 15 added the
      mediaProcessing type for exactly this ("time-consuming operations on
      media assets"); below 15 the service falls back to dataSync, which is
      what those versions accept for long-running local work.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Media3 merges ACCESS_NETWORK_STATE in for streaming it can do and this app
         never does. Geode is offline by design and its privacy policy says so; the
         shipped manifest should agree. Media3 treats the missing permission as
         "network type unknown", which is correct for local files. -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />
    <!--
      The theme pack's haptic cues name Android feedback constants, and the
      newest of them landed after minSdk 31, so older devices fall back to the
      vibration patterns the pack ships alongside them.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The live wallpaper is optional; the app is fully usable without a
         launcher that supports one. -->
    <uses-feature
        android:name="android.software.live_wallpaper"
        android:required="false" />

    <application
        android:name=".GeodeApp"
        android:allowBackup="true"
        android:appCategory="audio"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <!-- Android Auto: the playback service below is also a media browser. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <!--
          Picture-in-picture (#287): leaving the app from the full-screen Visual shrinks it into a
          small window where the Visual keeps drawing. Entering and leaving that window changes the
          screen size and layout, which the activity takes in place (configChanges) so the Visual's
          surface is resized rather than rebuilt. It needs no permission.
        -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Geode.Splash"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              Shared presets. A preset is a self-contained document and the
              app has no network permission, so a "shared" link IS the thing
              itself, carried inside it; tapping one in a chat opens the app
              and imports it. Nothing is fetched.
            -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="geode"
                    android:host="preset" />
            </intent-filter>
            <!-- Android Auto voice search: "play <something> on Geode" arrives here
                 with a query, and the activity plays the first library match. -->
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          The Style warm-up (#304): while the phone is idle and charging, every Style is drawn once
          offscreen so its programs are in the binary cache before anyone switches to it. Only the
          system may start it.
        -->
        <service
            android:name=".visuals.StyleWarmUpService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!--
          The visualizer as a live wallpaper: the same renderer, on the style
          and parameters the app was last left showing. It reacts to what the
          app is playing and breathes on its own the rest of the time.
        -->
        <service
            android:name=".wallpaper.VisualizerWallpaperService"
            android:exported="true"
            android:label="@string/wallpaper_label"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper" />
        </service>

        <!--
          Music that outlives the screen. Publishes Playback, the app's one
          playback store, as the MediaSession, so playback survives the
          Activity and every transport control becomes a Command to Playback.

          Exported, unlike every other component here, because the things that
          drive it are other processes: the notification and the lock screen,
          Bluetooth and wired headset buttons, watches, Android Auto. The
          MediaSession is the only surface any of them reach, and it exposes
          transport and the current track's own tags — nothing else, and
          nothing off the device, since the app holds no network permission.
        -->
        <service
            android:name=".playback.GeodePlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!--
          Media buttons, and with them playback resumption.

          Media3 routes hardware transport keys and the system's "resume what
          you were playing" request through a MEDIA_BUTTON broadcast, and it
          finds the target by looking for a receiver with this filter in the
          app's own manifest — the library declares none of its own. Without
          it the merged manifest carried exactly one receiver (the profile
          installer) and zero MEDIA_BUTTON filters, so the playback service's
          onPlaybackResumption was never invoked: Geode never appeared in
          the System UI media carousel after its process died, and
          its playback resumption was code that could not run in production.

          Exported, like the service it drives, because the callers are other
          processes: System UI, Bluetooth, a wired headset's buttons.
        -->
        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!--
          Keeps Studio's render queue alive while the app is not in front of the
          user. It does not own the Renders - Studio's store runs them - it follows
          the queue, shows its progress, and is sticky so a queue Android cut short
          resumes. Both types are declared because mediaProcessing does not exist
          before Android 15 and the service picks at runtime.
        -->
        <service
            android:name=".export.ExportService"
            android:exported="false"
            android:foregroundServiceType="mediaProcessing|dataSync" />

        <!-- Home-screen widget: artwork, title and transport, driven by the playback service's session. -->
        <receiver
            android:name=".widget.NowPlayingWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/now_playing_widget_info" />
        </receiver>

        <!-- Sharing a preset too long to be a link sends its .json; a raw
             file:// uri cannot leave the app, so it goes out through here.
             Scoped to the presets directory alone (preset_paths.xml). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.presets"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/preset_paths" />
        </provider>
    </application>
</manifest>
