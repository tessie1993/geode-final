<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- System splash shown while the process cold-starts. Background matches
         the Lapis Lazuli theme pack's, so the handoff to the App UI is seamless. -->
    <style name="Theme.Geode.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#050A20</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@android:style/Theme.Material.NoActionBar</item>
    </style>
</resources>
