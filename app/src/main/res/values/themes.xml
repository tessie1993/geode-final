<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- System splash shown while the process cold-starts. Background is the
         night glass's base (GlassPalettes.Dark), so the handoff to the App UI is
         seamless in the dark mode. The platform splash API (Android 12) reads
         these; the activity keeps this theme afterwards, which is the plain
         Material one underneath. The App UI makes no sounds, only haptics
         (#398), so no view plays the click sound either. -->
    <style name="Theme.Geode.Splash" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowSplashScreenBackground">#0B0F14</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:soundEffectsEnabled">false</item>
    </style>
</resources>
