    <string name="wallpaper_description">Your last Geode style, reacting to whatever the app is playing and drifting gently when it is not.</string>
    <string name="export_channel_name">Rendering video</string>
    <string name="export_channel_description">Shown while Geode is rendering a video, so the render is not interrupted.</string>
    <string name="export_notification_title">Rendering video</string>
    <string name="export_notification_text">Geode is rendering your visuals.</string>
