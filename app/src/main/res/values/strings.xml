    <!-- First-run photosensitivity notice. Safety copy: translate carefully,
         the flash rate is factual and must survive translation. This is an
         acknowledgement, not a choice — there is no setting behind it. -->
    <string name="safety_title">Before the visuals start</string>
    <string name="safety_warning">Geode reacts to music with light, and the visuals are intense — bright, fast and full-screen.</string>
    <string name="safety_prompt">The flash rate is limited in the engine, by design. Nothing on screen can flash more than three times a second, no preset or imported file can raise that, and the video you export is held to the same limit as the screen you saw. There is no setting for this and nothing to switch off.</string>
    <string name="safety_acknowledge">I understand</string>

