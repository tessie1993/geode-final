    <!-- First-run photosensitivity notice. Safety copy: translate carefully,
         the flash rate is factual and must survive translation. This is an
         acknowledgement, not a choice — there is no setting behind it. -->
    <string name="safety_title">Before the visuals start</string>
    <string name="safety_warning">Geode reacts to music with light, and the visuals are intense — bright, fast and full-screen.</string>
    <string name="safety_prompt">The flash rate is limited in the engine, by design. Nothing on screen can flash more than three times a second, no preset or imported file can raise that, and the video you export is held to the same limit as the screen you saw. There is no setting for this and nothing to switch off.</string>
    <string name="safety_acknowledge">I understand</string>

    <!-- First run: permission, then an optional folder. Nothing else is asked. -->
    <string name="first_run_access_title">A few permissions</string>
    <string name="first_run_access_body">Music access finds the songs on this device, notifications show what is playing, and the microphone lets the Visual react to live sound. Nothing leaves your phone — there is no account and no sign-in.</string>
    <string name="first_run_access_allow">Allow</string>
    <string name="first_run_access_skip">Not now</string>

    <!-- Walkthrough. Each step navigates to the tab it describes, so the app underneath
         is the thing being pointed at rather than a picture of it. -->
    <string name="tutorial_skip">Skip now</string>
    <string name="tutorial_back">Back</string>
    <string name="tutorial_next">Next</string>
    <string name="tutorial_finish">Got it</string>
    <string name="tutorial_progress">%1$d of %2$d</string>
    <string name="tutorial_dont_show">Don\'t show this next time</string>
    <string name="tutorial_player_title">This is the Mini-player</string>
    <string name="tutorial_player_body">The song playing, with play/pause and next, on every page but Home. Tap it for the full-screen Visual and all the controls.</string>
    <string name="tutorial_library_title">Your music lives here</string>
    <string name="tutorial_library_body">Tracks, albums, artists, folders and playlists. Tapping any track queues everything you are looking at, so Next and Previous behave the way you expect.</string>
    <string name="tutorial_visuals_title">Sixty-odd visual styles</string>
    <string name="tutorial_visuals_body">Pick a style, then open Customize to change how it moves. Presets save a whole look; Randomize on any tab is the fastest way to find one you like.</string>
    <string name="tutorial_touch_title">Touch the visuals</string>
    <string name="tutorial_touch_body">On the full-screen visualizer, your finger is part of the picture: one finger sets a point the style builds itself around, two set an axis, three or more open a swirl. Pinch and twist zoom and rotate.</string>
    <string name="tutorial_studio_title">Studio makes videos</string>
    <string name="tutorial_studio_body">Record a performance as you play with the controls, then render it out at any quality. Projects keep your videos together.</string>
    <string name="tutorial_settings_title">Everything else is in Settings</string>
    <string name="tutorial_settings_body">Themes, audio, playback, folders and safety. Settings › Battery saves power by drawing the Visual more lightly. Help lives here too — you can replay this walkthrough any time.</string>

    
    
