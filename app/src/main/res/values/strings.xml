    <!-- Settings › Audio: analysis, key colour, live input. -->
    <string name="audio_group_playback">Playback</string>
    <string name="audio_group_analysis">Analysis</string>
    <!-- Shown once per audio-DSP screen (playback/EQ), so nobody files "the visuals didn't
         change" as a bug per feature. See docs/AUDIO_CHAIN.md, "DSP does not move the visuals". -->
    <string name="audio_dsp_visuals_notice">Nothing on this screen touches the visuals. The picture is drawn from the raw audio before the equalizer, ReplayGain or any other effect here runs, so turning a knob changes what you hear and never what you see.</string>
    <string name="audio_beat_sensitivity">"Beat sensitivity  %1$sσ — drag right for LESS sensitive (fewer beat flashes)"</string>
    <string name="audio_beat_min_gap">"Minimum gap between beats  %1$d ms — never flash faster than %2$d BPM"</string>
    <string name="audio_slow_track">Slow track</string>
    <string name="audio_default">Default</string>
    <string name="audio_preset_morph">Preset morph: %1$.1f s (0 = snap)</string>
    <string name="audio_react_mic">React to the microphone</string>
    <string name="audio_react_mic_explainer">Plays nothing and drives the visuals from what the phone hears — a room, an instrument, a speaker across the street. Playback pauses while it is on, because the analyzer has one input and a track plus the room would just blur together. Audio is analysed live and never recorded, saved or sent anywhere.</string>
    <string name="audio_mic_denied">Microphone access is off for Geode. Turn it on in Android Settings › Apps › Geode › Permissions to use live input.</string>
    <string name="audio_mic_busy">The microphone could not be opened — another app may be using it.</string>
    <string name="audio_tune_room">Tune for what the phone is hearing</string>
    <string name="audio_profiles_explainer">Each sets the beat threshold, the reactivity envelope and the band balance together — they are one decision, and they live on three different screens. Every value stays an ordinary slider afterwards.</string>

    <!-- Export: shared by the Export tab and the export dialog. -->
    <string name="export_title">Export</string>
    <string name="export_group_defaults">Defaults</string>
    <string name="export_platform_preset">Platform preset</string>
    <string name="export_quality">Quality</string>
    <string name="export_frame_rate">Frame rate</string>
    <string name="export_codec">Video codec</string>
    <string name="export_codec_explainer">HEVC (H.265) makes files about a third smaller at the same quality. If a device cannot encode it, the render falls back to H.264 on its own.</string>
    <string name="export_codec_no_hevc">This device has no HEVC encoder; renders will use H.264 whichever is chosen.</string>
    <string name="export_aspect_ratio">Aspect ratio</string>
    <string name="export_fps_30">30 fps</string>
    <string name="export_fps_60">60 fps</string>
    <string name="export_loop_safe">Loop-safe</string>
    <string name="export_loop_safe_default">Loop-safe by default</string>
    <string name="export_loop_safe_explainer">Loop-safe trims the end of the render to a bar boundary so the clip repeats cleanly when a platform autoplays it. It needs a detected tempo, so a track that has not been analysed falls back to full length for that render.</string>
    <string name="export_video_button">Export video…</string>
    <string name="export_defaults_explainer">Starts from the defaults above; each render can change them for one video. The destination — your Videos library or a folder you pick — is chosen at render time, per export.</string>
