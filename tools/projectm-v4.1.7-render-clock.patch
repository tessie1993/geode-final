diff --git a/src/libprojectM/RandomSource.cpp b/src/libprojectM/RandomSource.cpp
new file mode 100644
index 000000000..22d463b16
--- /dev/null
+++ b/src/libprojectM/RandomSource.cpp
@@ -0,0 +1,61 @@
+#include "RandomSource.hpp"
+
+#include <projectm-eval.h>
+
+namespace libprojectM {
+
+namespace {
+
+thread_local RandomSource::Engine* currentEngine{nullptr};
+
+auto FallbackEngine() -> RandomSource::Engine&
+{
+    thread_local RandomSource::Engine fallback{std::random_device{}()};
+    return fallback;
+}
+
+// projectm-eval's rand() keeps Milkdrop's own process-wide generator; inside a seeded scope it
+// draws from the instance's engine instead, so expression code is reproducible per instance too.
+auto EvalRandomSource(uint32_t* value) -> int
+{
+    if (!RandomSource::Seeded())
+    {
+        return 0;
+    }
+    *value = RandomSource::Next();
+    return 1;
+}
+
+} // namespace
+
+RandomSource::Scope::Scope(Engine* engine)
+    : m_previous(currentEngine)
+{
+    if (engine != nullptr)
+    {
+        projectm_eval_set_random_source(&EvalRandomSource);
+        currentEngine = engine;
+    }
+}
+
+RandomSource::Scope::~Scope()
+{
+    currentEngine = m_previous;
+}
+
+auto RandomSource::Current() -> Engine&
+{
+    return currentEngine != nullptr ? *currentEngine : FallbackEngine();
+}
+
+auto RandomSource::Next() -> uint32_t
+{
+    return static_cast<uint32_t>(Current()());
+}
+
+auto RandomSource::Seeded() -> bool
+{
+    return currentEngine != nullptr;
+}
+
+} // namespace libprojectM
diff --git a/src/libprojectM/RandomSource.hpp b/src/libprojectM/RandomSource.hpp
new file mode 100644
index 000000000..2c1799bcd
--- /dev/null
+++ b/src/libprojectM/RandomSource.hpp
@@ -0,0 +1,55 @@
+#pragma once
+
+#include <cstdint>
+#include <random>
+
+namespace libprojectM {
+
+/**
+ * @brief The one generator every random draw in libprojectM takes from.
+ *
+ * Geode patch (tools/projectm-v4.1.7-render-clock.patch). An instance given a seed with
+ * projectm_set_random_seed() owns an engine and makes it current on the calling thread for the
+ * duration of every call that can draw a random number (see Scope), so two instances never share
+ * random state and a seeded instance draws the same numbers every time. Outside a seeded scope,
+ * Current() is a per-thread engine seeded from std::random_device, which is what stock projectM
+ * did everywhere.
+ */
+class RandomSource
+{
+public:
+    using Engine = std::mt19937;
+
+    /**
+     * @brief Makes @a engine current on this thread until the scope ends; null keeps the current one.
+     * Scopes nest; the previous engine is restored on exit.
+     */
+    class Scope
+    {
+    public:
+        explicit Scope(Engine* engine);
+        ~Scope();
+        Scope(const Scope&) = delete;
+        auto operator=(const Scope&) -> Scope& = delete;
+
+    private:
+        Engine* m_previous;
+    };
+
+    /**
+     * @brief The engine of the innermost seeded scope on this thread, or this thread's fallback engine.
+     */
+    static auto Current() -> Engine&;
+
+    /**
+     * @brief A 32-bit value drawn from the current engine.
+     */
+    static auto Next() -> uint32_t;
+
+    /**
+     * @brief True inside a seeded scope.
+     */
+    static auto Seeded() -> bool;
+};
+
+} // namespace libprojectM
