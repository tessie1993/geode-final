mv_r=1.000
mv_g=1.000
mv_b=1.000
mv_a=0.000
per_frame_1=dx = 0.004*(rand(1000)/1000 - 0.5);
per_frame_2=dy = -0.002 - 0.003*mid_att + 0.003*(rand(1000)/1000 - 0.5);
per_frame_3=zoom = 1.0 + 0.01*bass_att;
per_frame_4=rot = 0.01*sin(time*0.7);
per_frame_5=wave_r = 0.4 + 0.4*sin(time*1.3) + 0.2*rand(100)/100;
per_frame_6=wave_g = 0.5 + 0.4*sin(time*0.9 + 1.0);
per_frame_7=wave_b = 0.5 + 0.4*sin(time*0.7 + 2.0);
per_frame_8=wave_a = 0.6 + 0.4*mid_att;
per_pixel_1=warp = warp + 0.02*sin(x*5.0 + time)*treb_att + 0.01*rand(100)/100;
warp_1=`shader_body
warp_2=`{
warp_3=`    float3 grain = tex2D(sampler_noise_lq, uv * 2.0 + rand_frame.xy).xyz;
warp_4=`    ret = tex2D(sampler_main, uv).xyz * 0.96 + (grain - 0.5) * 0.08 + rand_preset.xyz * 0.02;
warp_5=`}
comp_1=`shader_body
comp_2=`{
comp_3=`    ret = tex2D(sampler_main, uv).xyz * (0.9 + 0.2 * rand_preset.x) + 0.05 * rand_frame.yzw;
comp_4=`}
