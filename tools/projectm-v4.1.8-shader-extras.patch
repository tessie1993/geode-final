+// A two-row, one-channel float texture, filtered linearly and clamped at its edges.
+auto MakeAudioTexture(const char* name, int width) -> std::shared_ptr<Texture>
+{
+    GLuint tex{};
+    glGenTextures(1, &tex);
+    glBindTexture(GL_TEXTURE_2D, tex);
+    const std::vector<float> zeros(static_cast<size_t>(width) * 2, 0.0f);
