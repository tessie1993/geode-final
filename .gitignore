# Build output
.gradle/
build/
.cxx/
.kotlin/
local.properties

# Upload-key material — never commit.
keystore.properties
*.jks
*.keystore

# Service credentials. The upload feature needs OAuth client ids and secrets
# for YouTube, TikTok and Instagram, and the moment those exist locally they
# must not be committable — a leaked client secret is a rotation and a store
# re-verification, not an inconvenience.
.env
.env.*
!.env.example
secrets.properties
google-services.json

# Agent tooling: .claude/ and AGENTS.md are shared through the repository so
# cloud sessions get them; personal overrides stay local.
.claude/settings.local.json
.claude/worktrees/
.agents/
.codex/
__pycache__/
.venv-hooks/
*.logcat
